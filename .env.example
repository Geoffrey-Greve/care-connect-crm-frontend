# Backend API root used by the RTK Query base api.
VITE_PUBLIC_BASE_URL=""

# Supabase project. The anon key is safe to ship in the client bundle ONLY as
# long as row level security actually restricts what `anon` can do -- see
# supabase/migrations for the policies.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Google Maps JS API key, used by AreaTracker / CarerLiveLocation / AddEventForm.
# Vite inlines this into the bundle, so restrict the key by HTTP referrer in the
# Google Cloud console.
VITE_GOOGLE_MAPS_API_KEY=""
